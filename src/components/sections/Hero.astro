---
import { messages, type LocaleProps } from '../../i18n';
import { kickerClass, sectionHeadingClass, buttonClass } from '../../styles/classes';
import ArrowIcon from '../ui/ArrowIcon.astro';
import SocialLinks from '../ui/SocialLinks.astro';
import '../../styles/hero.css';
interface Props extends LocaleProps {}
const t = messages[Astro.props.locale].hero;
---
<!-- Presentacion principal y acceso directo a las secciones. -->
<section class="relative min-h-[860px] overflow-hidden bg-[#282c2b] text-white max-[760px]:min-h-[820px]" id="inicio">
  <div class="hero-photo" role="img" aria-label={t.image}></div>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-reveal relative z-[2] mx-auto w-[min(1120px,calc(100%_-_48px))] pt-[205px] text-left max-[760px]:w-auto max-[760px]:px-6 max-[760px]:pt-[360px] max-[760px]:pb-[150px]">
    <p class={kickerClass}>{t.role}</p>
    <h1 class={`${sectionHeadingClass} max-w-[790px] text-[clamp(68px,7.4vw,110px)] leading-[0.84] max-[760px]:text-[56px]`}>
      {t.design}<span class="block font-bold">{t.develop}</span>{t.scale}
    </h1>
    <p class="my-8 max-w-[650px] text-lg leading-[1.6] font-medium max-[760px]:text-base">{t.description}</p>
    <div class="flex items-center gap-7 max-[760px]:items-stretch max-[760px]:flex-col max-[760px]:gap-3.5">
      <a class={`${buttonClass} bg-white text-ink`} href="#proyectos">{t.projects}<ArrowIcon /></a>
      <a class="text-link border-b-2 border-current px-0 pt-2.5 pb-1.5 font-display font-bold tracking-[1px] uppercase max-[760px]:self-start" href="#sobre-mi">{t.profile}</a>
    </div>
    <div class="mt-6">
      <SocialLinks locale={Astro.props.locale} iconsOnly />
    </div>
  </div>
  <div aria-hidden="true">
    <div class="shape shape-blue-one"></div><div class="shape shape-lilac-one"></div>
    <div class="shape shape-cyan-one"></div><div class="shape shape-coral-one"></div>
  </div>
</section>
