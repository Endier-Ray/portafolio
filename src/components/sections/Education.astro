---
import { messages, type LocaleProps } from '../../i18n';
import { kickerClass, largeSectionHeadingClass } from '../../styles/classes';
import ArrowIcon from '../ui/ArrowIcon.astro';
interface Props extends LocaleProps {}
const t = messages[Astro.props.locale].education;
const certificate = t.certification;
---
<!-- Formacion academica y aprendizaje continuo. -->
<section class="grid grid-cols-[minmax(300px,0.9fr)_minmax(0,1.1fr)] gap-20 bg-brand-lilac px-[max(7vw,40px)] py-[115px] max-[760px]:grid-cols-1 max-[760px]:px-6 max-[760px]:py-20" aria-labelledby="education-title">
  <div data-reveal>
    <p class={kickerClass}>{t.label}</p>
    <h2 class={largeSectionHeadingClass} id="education-title">
      {t.learn}<br /><span class="inline-block bg-ink px-[0.12em] py-[0.04em] text-white">{t.apply}</span><br />{t.evolve}
    </h2>
  </div>
  <div class="min-w-0 border-t-2 border-ink" data-reveal>
      <article class="border-b border-ink/35 py-8">
        <span class="font-display text-[13px] font-bold tracking-[2px] uppercase">{t.ongoing}</span>
        <h3 class="mt-2.5 mb-1.5 font-display text-[clamp(28px,3vw,42px)] leading-none">{t.degree}</h3>
        <p class="m-0">{t.university}</p>
      </article>
      <article class="mt-8 border-l-[6px] border-brand-blue bg-white/70 p-8 max-[760px]:p-6">
        <div class="flex flex-wrap items-center justify-between gap-3 text-xs font-bold uppercase">
          <span class="inline-flex items-center gap-2 text-[#185c3a]"><span class="size-2 rounded-full bg-current" aria-hidden="true"></span>{certificate.status}</span>
          <time datetime="2026-09-28">{certificate.date}</time>
        </div>
        <p class="mt-7 mb-2 font-display text-sm font-bold uppercase">{certificate.type}</p>
        <h3 class="m-0 font-display text-[42px] leading-none max-[760px]:text-[36px]">{certificate.title}</h3>
        <p class="mt-3 font-semibold leading-[1.6]">{certificate.provider}</p>
        <p class="mt-4 leading-[1.7]">{certificate.description}</p>
        <p class="mt-6 font-display text-sm font-bold uppercase">{certificate.coursesLabel}</p>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-[1.6]">
          {certificate.courses.map((course) => <li>{course}</li>)}
        </ul>
        <a class="action-button mt-7 inline-flex min-h-12 max-w-full items-center justify-between gap-5 bg-ink px-5 py-4 font-display font-bold text-white uppercase" href="https://coursera.org/share/74aa79bd1b2b93a5fe06f5414339165b" target="_blank" rel="noopener noreferrer">
          <span>{certificate.visit}</span><ArrowIcon />
        </a>
      </article>
  </div>
</section>
