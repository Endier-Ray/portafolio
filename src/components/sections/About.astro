---
import { messages, type LocaleProps } from '../../i18n';
import { kickerClass } from '../../styles/classes';
import ArrowIcon from '../ui/ArrowIcon.astro';
interface Props extends LocaleProps {}
const t = messages[Astro.props.locale].about;
const highlights = [
  { title: t.frontend, description: t.frontendDescription, color: 'border-brand-blue' },
  { title: t.backend, description: t.backendDescription, color: 'border-brand-lilac' },
  { title: t.infrastructure, description: t.infrastructureDescription, color: 'border-brand-cyan' },
];
---
<!-- Perfil y especialidades: los textos se mantienen en i18n. -->
<section class="relative mx-auto max-w-[1240px] overflow-hidden px-10 pt-[125px] pb-[110px] text-left max-[760px]:px-6 max-[760px]:py-20" id="sobre-mi">
  <div class="shape shape-lilac-two" aria-hidden="true"></div>
  <div class="shape shape-blue-two" aria-hidden="true"></div>
  <p class={kickerClass}>{t.label}</p>
  <div class="flex flex-col items-start text-left max-[760px]:gap-[45px]" data-reveal>
    <h2 class="m-0 max-w-[900px] font-display text-[clamp(52px,6vw,90px)] leading-[0.95] font-semibold tracking-[-2px] max-[760px]:text-[49px]">
      {t.complex}<span class="block text-brand-blue">{t.simple}</span>{t.robust}
    </h2>
    <div class="max-w-[650px] pt-[42px] text-[17px] leading-[1.75]">
      <p class="mb-[18px] text-[21px] leading-[1.55] font-semibold">{t.intro}</p>
      <p class="mb-[18px]">{t.description}</p>
      <ul class="my-8 grid list-none gap-2.5 p-0">
        {highlights.map((item) => (
          <li class={`${item.color} profile-highlight border-l-[7px] bg-white/55 py-[19px] pr-[22px] pl-[26px] text-[15px] leading-[1.6]`}>
            <strong class="mb-0.5 block font-display text-lg leading-[1.2] tracking-[0.6px] uppercase">{item.title}</strong>
            {item.description}
          </li>
        ))}
      </ul>
      <p class="mb-[18px]">{t.current}</p>
      <div class="mt-3 flex flex-wrap items-center gap-6">
        <a class="group text-link inline-flex items-center gap-[18px] border-b-2 border-ink pb-1.5 font-display font-bold" href="#experiencia">
          {t.trajectory}<ArrowIcon />
        </a>
      </div>
    </div>
  </div>
</section>
