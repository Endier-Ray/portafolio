---
import { messages, type LocaleProps } from '../../i18n';
import { kickerClass, largeSectionHeadingClass, tagClass } from '../../styles/classes';
interface Props extends LocaleProps {}
const t = messages[Astro.props.locale].experience;
const jobs = [
  {
    company: 'DesignsGDL', period: t.current, role: t.role, title: t.title,
    url: 'https://desingsgdl.com.mx/',
    description: t.description, details: null, highlights: [],
    areas: [t.fullstack, t.ui, t.operations],
  },
  { company: 'BUSTUM.mx', url: 'https://bustum.mx/', ...t.bustum },
];
---
<!-- Trayectoria profesional independiente de proyectos y formacion. -->
<section class="grid grid-cols-[minmax(280px,0.7fr)_minmax(0,1.3fr)] gap-[70px] bg-brand-cyan px-[max(6vw,40px)] py-[110px] max-[1050px]:grid-cols-1 max-[760px]:px-6 max-[760px]:py-20" id="experiencia">
  <div data-reveal>
    <p class={kickerClass}>{t.label}</p>
    <h2 class={largeSectionHeadingClass}>{t.heading}</h2>
  </div>
  <div class="grid min-w-0 gap-14">
  {jobs.map((job) => (
  <article class="grid grid-cols-[180px_1fr] border-t-2 border-ink max-[760px]:grid-cols-1" data-reveal>
    <div class="flex flex-col gap-2 border-r border-ink/25 pt-[30px] pr-7 font-display uppercase max-[760px]:border-r-0 max-[760px]:border-b max-[760px]:border-ink/25 max-[760px]:pb-6">
      <span class="text-[13px] font-bold tracking-[2px] uppercase">{job.period}</span>
      <strong class="text-[22px]">
        <a href={job.url} target="_blank" rel="noopener noreferrer" class="underline decoration-1 underline-offset-4">{job.company}</a>
      </strong>
    </div>
    <div class="pt-[30px] pl-[38px] max-[760px]:pl-0">
      <p class="text-[13px] font-bold tracking-[2px] uppercase">{job.role}</p>
      <h3 class="mt-2.5 mb-[22px] max-w-[700px] font-display text-[clamp(34px,4vw,54px)] leading-none">{job.title}</h3>
      {job.details && <p class="mb-4 text-sm leading-[1.6]">{job.details}</p>}
      <p class="max-w-[700px] leading-[1.7]">{job.description}</p>
      {job.highlights.length > 0 && (
        <ul class="mt-5 max-w-[700px] list-disc space-y-3 pl-5 leading-[1.7]">
          {job.highlights.map((highlight) => <li>{highlight}</li>)}
        </ul>
      )}
      <ul class="mt-[30px] flex list-none flex-wrap gap-2 p-0" aria-label={t.responsibilities}>
        {job.areas.map((item) => <li class={tagClass}>{item}</li>)}
      </ul>
    </div>
  </article>
  ))}
  </div>
</section>
