---
import type { Project } from '../data/projects';
import { messages, type LocaleProps } from '../i18n';
import { tagClass } from '../styles/classes';
interface Props extends LocaleProps { project: Project }
const { locale, project } = Astro.props;
const copy = project.copy[locale];
const t = messages[locale].projects;
---
<article class={`grid min-h-[330px] grid-cols-[95px_1fr_260px] text-ink max-[1050px]:grid-cols-[80px_1fr_210px] max-[760px]:block ${project.color}`} data-reveal>
  <div class="border-r border-ink/30 px-[30px] py-[35px] font-display text-xl font-bold max-[760px]:border-0 max-[760px]:px-6 max-[760px]:pt-[22px] max-[760px]:pb-0">{project.number}</div>
  <div class="min-w-0 px-[45px] py-[35px] max-[760px]:px-6 max-[760px]:py-5">
    <p class="mb-[18px] text-xs font-bold tracking-[2px] uppercase">{copy.type}</p>
    <h3 class="m-0 font-display text-[clamp(42px,4.5vw,62px)] leading-none max-[760px]:text-[58px]">
      <span class="project-short-title" aria-hidden="true">{copy.shortTitle}</span>
      <span class="sr-only">{copy.title}</span>
    </h3>
    <p class="mt-3 font-display font-bold tracking-[1px] uppercase">{copy.role}</p>
    <p class="mt-3 max-w-[650px] leading-[1.6]">{copy.description}</p>
    <ul class="mt-[22px] flex list-none flex-wrap gap-[7px] p-0" aria-label={`${t.technologies} ${copy.title}`}>
      {project.tech.map((tech) => <li class={`${tagClass} px-2.5 py-1.5 text-xs`}>{tech}</li>)}
    </ul>
  </div>
  <div class="flex items-end justify-between p-[35px] font-display font-semibold tracking-[1px] uppercase max-[760px]:px-6 max-[760px]:pt-0 max-[760px]:pb-[25px]" aria-hidden="true">
    <span>{t.featured}</span><span class="border-t-2 border-current pt-2 text-xs">{t.overview}</span>
  </div>
</article>
